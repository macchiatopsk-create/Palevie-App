# -----------------------------
# Palevie — local / production
# -----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional in demo; required for production auth/cloud history/quotas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (Merchant of Record: THEY remit US sales tax, not you)
# Create two subscription variants, paste each hosted checkout URL:
LS_MONTHLY_CHECKOUT_URL=
LS_YEARLY_CHECKOUT_URL=
# Settings > Webhooks: secret + subscribe to subscription_* events, point at
# /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=

# OpenAI (optional AI-assisted selfie scan + optional short explanation)
# Keep API keys SERVER ONLY. Do not expose in NEXT_PUBLIC_* vars.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_EXPLAIN_MODEL=
PALEVIE_AI_EXPLANATIONS_ENABLED=false

# AI cost guardrails. App-side caps are defense-in-depth; also set a project spend limit with the provider.
PALEVIE_AI_ENABLED=true
PALEVIE_AI_USER_DAILY_CALL_CAP=2
PALEVIE_AI_MONTHLY_CALL_CAP=10000
PALEVIE_AI_MONTHLY_BUDGET_USD=100
PALEVIE_AI_ESTIMATED_COST_PER_SCAN_USD=0.01

# Usage entitlement defaults
PALEVIE_FREE_PRODUCT_CHECKS_MONTHLY=5
PALEVIE_PLUS_PRODUCT_CHECKS_MONTHLY=100

# Affiliate helpers
# Amazon can use an Associate tag. Other networks generally provide tracked URLs/feeds; store those URLs on offers.
AMAZON_ASSOCIATE_TAG=

# Optional admin dashboard lock. If blank, /admin/growth only shows browser-local demo data.
PALEVIE_ADMIN_KEY=

# Optional operational alerts (not wired by default)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Internal normalized affiliate conversion endpoint
PALEVIE_AFFILIATE_POSTBACK_SECRET=

# --- Optional selfie skin analysis providers (choose one for /diagnose skin) ---
# Option A: generic vision model (personal-color tone estimate) — cheaper, less specialized
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# Option B: Perfect Corp / YouCam (beauty-specialized skin analysis; they handle
# HIPAA/GDPR compliance). Sign up for a key, then set:
PERFECTCORP_API_KEY=
PERFECTCORP_API_BASE=
# AI budget guardrails (planning caps; not provider billing)
PALEVIE_AI_DAILY_VISITOR_CAP=2
PALEVIE_AI_MONTHLY_CALL_CAP=10000
