# Palevie is free: no checkout URLs, subscription plans or user payment keys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional existing external AI. No calls until explicitly enabled AND capped.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_EXPLAIN_MODEL=
PALEVIE_AI_ENABLED=false
PALEVIE_AI_EXPLANATIONS_ENABLED=false
PALEVIE_AI_QUOTA_SALT=
PALEVIE_AI_USER_DAILY_CALL_CAP=2
PALEVIE_AI_MONTHLY_CALL_CAP=0
PALEVIE_AI_MONTHLY_BUDGET_USD=0
PALEVIE_AI_ESTIMATED_COST_PER_SCAN_USD=0.01
# These are app-side estimated-spend guardrails, not a provider invoice guarantee.

AMAZON_ASSOCIATE_TAG=
PALEVIE_ADMIN_KEY=
PALEVIE_AFFILIATE_POSTBACK_SECRET=
