# Palevie is free: no user checkout, credit purchases or subscription plans.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=0
NEXT_PUBLIC_ENABLE_APPLE_AUTH=0

# Optional external AI. No calls until explicitly enabled AND capped.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_EXPLAIN_MODEL=
PALEVIE_AI_ENABLED=false
PALEVIE_AI_EXPLANATIONS_ENABLED=false
PALEVIE_AI_QUOTA_SALT=
PALEVIE_AI_USER_DAILY_CALL_CAP=2
PALEVIE_AI_MONTHLY_CALL_CAP=0
PALEVIE_AI_MONTHLY_BUDGET_USD=0
PALEVIE_AI_ESTIMATED_COST_PER_SCAN_USD=0.01
# App-side estimated-spend guardrails, not a provider invoice guarantee.

AMAZON_ASSOCIATE_TAG=
PALEVIE_ADMIN_KEY=
PALEVIE_AFFILIATE_POSTBACK_SECRET=
