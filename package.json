{
  "name": "palevie-mvp",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-drape-guide.mjs && next dev",
    "build": "node scripts/test-free-service.cjs && node scripts/test-mobile-safety.cjs && node scripts/test-tone-evidence.cjs && node scripts/test-scan-fallback.cjs && node scripts/test-drape-guide.cjs && node scripts/test-tryon-coverage.cjs && node scripts/test-quiz-entry.cjs && node scripts/test-quiz-touch.cjs && node scripts/test-result-shopping.cjs && node scripts/test-server-visit-analytics.cjs && node scripts/test-search-discovery.cjs && node scripts/prepare-drape-guide.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:free-service": "node scripts/test-free-service.cjs",
    "test:mobile-safety": "node scripts/test-mobile-safety.cjs",
    "test:scan-fallback": "node scripts/test-scan-fallback.cjs",
    "test:tryon": "node scripts/test-tryon-coverage.cjs",
    "test:quiz-entry": "node scripts/test-quiz-entry.cjs",
    "test:quiz-touch": "node scripts/test-quiz-touch.cjs",
    "test:result-shopping": "node scripts/test-result-shopping.cjs",
    "test:search-discovery": "node scripts/test-search-discovery.cjs",
    "test:tone-evidence": "node scripts/test-tone-evidence.cjs",
    "test:quiz": "tsc lib/quiz.ts lib/palettes.ts lib/types.ts --outDir .quiztest --module commonjs --target es2020 --esModuleInterop --skipLibCheck && node scripts/test-quiz.cjs",
    "test:skin": "tsc -p tsconfig.skintest.json && node -e \"const f='.skintest/lib/skincare.js',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/@\\\\/data\\\\/products/g,'../data/products'))\" && node scripts/test-skin.cjs",
    "test:drape-guide": "node scripts/test-drape-guide.cjs",
    "test:server-visits": "node scripts/test-server-visit-analytics.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@supabase/supabase-js": "2.110.2",
    "next": "^16.3.0",
    "postcss": "^8.5.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
